<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>BaseiOSApp</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- The two runtime flavors carry separate bundle IDs so macOS
	     LaunchServices treats them as distinct apps (a shared ID made it
	     impossible to run an iOS-flavor guest and a Catalyst-flavor guest at
	     the same time: `open` on the second flavor just activated the running
	     instance). Each flavor gets its own sandbox container, and guests are
	     migrated between containers when their runtime mode changes. Expanded
	     at build time. -->
	<key>RuntimeCatalystBundleIdentifier</key>
	<string>$(DEVELOPMENT_TEAM).dev.ohaiibuzzle.BaseiOSApp.RuntimeCatalyst</string>
	<key>RuntimeiOSBundleIdentifier</key>
	<string>$(DEVELOPMENT_TEAM).dev.ohaiibuzzle.BaseiOSApp.RuntimeiOS</string>
	<!-- Stable base for the keychain slot access groups (".shared[.N]").
	     Deliberately independent of the runtime bundle IDs above: keychain
	     items are keyed by access group, so keeping this constant means the
	     split didn't orphan any guest keychain data. The host and both
	     runtimes must all carry matching keychain-access-groups entitlements. -->
	<key>KeychainAccessGroupBase</key>
	<string>$(DEVELOPMENT_TEAM).dev.ohaiibuzzle.BaseiOSApp</string>
	<!-- Bundle ID the runtime apps shared before the flavor split. The
	     pre-split single sandbox container (~/Library/Containers/<this ID>)
	     still holds existing guests; the host migrates them out once, then
	     retires the directory. -->
	<key>LegacyRuntimeBundleIdentifier</key>
	<string>$(DEVELOPMENT_TEAM).dev.ohaiibuzzle.BaseiOSApp</string>
</dict>
</plist>
