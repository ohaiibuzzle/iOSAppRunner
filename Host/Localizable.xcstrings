    "Every keychain item stored by guest apps will be deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every keychain item stored by guest apps will be deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストアプリが保存したキーチェーン項目はすべて削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트 앱이 저장한 모든 키체인 항목이 삭제됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi mục keychain do ứng dụng khách lưu sẽ bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除所有应用存储的钥匙串项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將刪除所有 App 儲存的鑰匙圈項目。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los elementos del Llavero guardados por las apps invitadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les éléments du Trousseau enregistrés par les apps invitées seront supprimés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Schlüsselbundeinträge, die von Gast-Apps gespeichert wurden, werden gelöscht."
          }
        }
      }
    },
    "Every running app is force-quit immediately. Unsaved progress is lost." : {
      "comment" : "A description of the alert that appears when the user tries to kill all runtimes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のアプリはすべてすぐに強制終了されます。保存されていない作業は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 모든 앱이 즉시 강제 종료됩니다. 저장되지 않은 작업은 손실됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi ứng dụng đang chạy sẽ bị buộc thoát ngay lập tức. Tiến trình chưa lưu sẽ bị mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有正在运行的应用将被立即强制退出，未保存的进度将丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有執行中的 App 將立即被強制結束，未儲存的進度將會遺失。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se forzará el cierre de todas las apps en ejecución de inmediato. Se perderá el progreso no guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps en cours d'exécution seront immédiatement forcées à quitter. Les modifications non enregistrées seront perdues."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle laufenden Apps werden sofort zwangsbeendet. Nicht gesicherter Fortschritt geht verloren."
          }
        }
      }
    },
