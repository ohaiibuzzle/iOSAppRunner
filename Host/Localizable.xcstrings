    "Removes the app bundle, the guest's data directory, and its keychain slot (wiped so the slot number can be reused)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the app bundle, the guest's data directory, and its keychain slot (wiped so the slot number can be reused)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリバンドル、ゲストのデータディレクトリ、およびキーチェーンスロットを削除します（スロット番号を再利用できるよう消去されます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 번들, 게스트 데이터 디렉터리, 키체인 슬롯을 제거합니다(슬롯 번호를 재사용할 수 있도록 키체인 항목을 지웁니다)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa bundle ứng dụng, thư mục dữ liệu của ứng dụng khách và ô keychain (được xóa sạch để có thể tái sử dụng số ô)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除应用包、应用的数据目录及其钥匙串槽位（清空后槽位编号可供重用）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 App 套件、App 的資料資料夾及其鑰匙圈槽位（會清除，使槽位編號可再利用）。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el paquete de la app, su directorio de datos y su ranura del Llavero (que se borra para poder reutilizar el número de ranura)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime le paquet de l'app, le répertoire de données de l'invitée et son emplacement du Trousseau (effacé pour que son numéro puisse être réutilisé)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt das App-Bundle, das Datenverzeichnis des Gasts und seinen Schlüsselbund-Slot (wird gelöscht, damit die Slot-Nummer wiederverwendet werden kann)."
          }
        }
      }
    },
