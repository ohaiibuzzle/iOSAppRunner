    "Deletes the app's keychain items (logins, sessions, tokens). The app stays installed and keeps its data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the app's keychain items (logins, sessions, tokens). The app stays installed and keeps its data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのキーチェーン項目（ログイン情報、セッション、トークン）を削除します。アプリはインストールされたままで、データも保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 키체인 항목(로그인, 세션, 토큰)을 삭제합니다. 앱은 설치된 상태로 유지되며 데이터도 그대로 남습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa các mục keychain của ứng dụng (đăng nhập, phiên, mã thông báo). Ứng dụng vẫn được cài đặt và giữ nguyên dữ liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除应用的钥匙串项目（登录信息、会话和令牌）。应用将保持安装，数据不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 App 的鑰匙圈項目（登入資訊、工作階段和權杖）。App 會保持安裝，並保留其資料。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los elementos del Llavero de la app (inicios de sesión, sesiones y tokens). La app se mantiene instalada y conserva sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les éléments du Trousseau de l'app (identifiants, sessions, jetons). L'app reste installée et conserve ses données."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht die Schlüsselbundeinträge der App (Anmeldungen, Sitzungen, Token). Die App bleibt installiert und behält ihre Daten."
          }
        }
      }
    },
