    "Could not assign a keychain slot for %@. Free one by deleting an unused app, then try again." : {
      "comment" : "A description of an error that might occur when launching a guest.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のキーチェーンスロットを割り当てできませんでした。未使用のアプリを削除して空きを作り、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 키체인 슬롯을 할당할 수 없습니다. 사용하지 않는 앱을 삭제해 슬롯을 확보한 뒤 다시 시도하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể gán ô keychain cho %@. Hãy xóa một ứng dụng không dùng để giải phóng ô, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法为 %@ 分配钥匙串槽位。请删除一个未使用的应用以释放槽位，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法為 %@ 指派鑰匙圈槽位。請刪除一個未使用的 App 以釋出槽位，然後再試一次。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo asignar una ranura del Llavero a %@. Libera una eliminando una app que no uses y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'attribuer un emplacement du Trousseau à %@. Libérez-en un en supprimant une app inutilisée, puis réessayez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ konnte kein Schlüsselbund-Slot zugewiesen werden. Löschen Sie eine nicht verwendete App, um einen freizugeben, und versuchen Sie es erneut."
          }
        }
      }
    },
