          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 现已位于 %@ 运行时容器中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 目前位於 %@ 執行階段容器中。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ahora está en el contenedor del entorno de ejecución %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app %@ se trouve désormais dans le conteneur de l'environnement d'exécution %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App %@ befindet sich jetzt im Container der Laufzeitumgebung %@."
          }
        }
      }
    },
