{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ has no bundle ID, so there is nothing to reset." : {
      "comment" : "A description of an error that might occur when resetting a guest's keychain.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にはバンドル ID がないため、リセットする対象がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 번들 ID가 없으므로 재설정할 항목이 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không có bundle ID nên không có gì để đặt lại."
