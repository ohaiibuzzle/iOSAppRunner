    "All %lld keychain slots are in use; delete an app to free one." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All %lld keychain slots are in use; delete an app to free one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーンスロットがすべて使用中です（%lld 個）。空きを作るにはアプリを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키체인 슬롯 %lld개가 모두 사용 중입니다. 앱을 삭제해 슬롯을 확보하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã dùng hết %lld ô keychain; hãy xóa một ứng dụng để giải phóng ô."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串槽位（共 %lld 个）已全部占用；请删除一个应用以释放槽位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑰匙圈槽位（共 %lld 個）已全部使用；請刪除一個 App 以釋出槽位。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las %lld ranuras del Llavero están en uso; elimina una app para liberar una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %lld emplacements du Trousseau sont tous utilisés ; supprimez une app pour en libérer un."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %lld Schlüsselbund-Slots sind belegt; löschen Sie eine App, um einen freizugeben."
          }
        }
      }
    },
