    "%@ is running; quit it before deleting it." : {
      "comment" : "A description of an error that might occur when deleting a guest while it is running.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は実行中です。削除する前に終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 실행 중입니다. 삭제하기 전에 종료하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang chạy; hãy thoát trước khi xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行，请先退出再删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在執行中，請先結束再刪除。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en ejecución; ciérrala antes de eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app %@ est en cours d'exécution ; quittez-la avant de la supprimer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App %@ läuft; beenden Sie sie, bevor Sie sie löschen."
          }
        }
      }
    },
    "%@ is running; quit it before switching its runtime." : {
      "comment" : "A description of an error that might occur when migrating a guest. The argument is the name of the guest.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は実行中です。ランタイムを切り替える前に終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 실행 중입니다. 런타임을 전환하기 전에 종료하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang chạy; hãy thoát trước khi đổi runtime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行，请先退出再切换其运行时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在執行中，請先結束再切換其執行階段。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en ejecución; ciérrala antes de cambiar su entorno de ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app %@ est en cours d'exécution ; quittez-la avant de changer son environnement d'exécution."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App %@ läuft; beenden Sie sie, bevor Sie ihre Laufzeitumgebung wechseln."
          }
        }
      }
    },
    "%@ is set to the %@ runtime, but its data still resides in the %@ container. Open its Compatibility Settings and close the sheet to finish the switch." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は %@ ランタイム用に設定されていますが、データはまだ %@ コンテナにあります。「互換性設定」を開いてシートを閉じると、切り替えが完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) %@ 런타임으로 설정되어 있지만, 데이터는 아직 %@ 컨테이너에 있습니다. 호환성 설정을 열고 시트를 닫으면 전환이 완료됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ được đặt sang runtime %@, nhưng dữ liệu vẫn nằm trong thư mục chứa %@. Hãy mở Cài đặt tương thích và đóng cửa sổ để hoàn tất việc chuyển đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已设为 %@ 运行时，但其数据仍位于 %@ 容器中。请打开其兼容性设置并关闭面板以完成切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已設定為 %@ 執行階段，但其資料仍位於 %@ 容器中。請開啟其相容性設定並關閉面板以完成切換。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está configurada para el entorno de ejecución %@, pero sus datos siguen en el contenedor %@. Abre sus Ajustes de compatibilidad y cierra la hoja para completar el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app %@ est configurée pour l'environnement d'exécution %@, mais ses données se trouvent toujours dans le conteneur %@. Ouvrez ses Réglages de compatibilité et fermez la feuille pour terminer le changement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App %@ ist für die Laufzeitumgebung %@ eingestellt, ihre Daten befinden sich aber noch im Container %@. Öffnen Sie die Kompatibilitätseinstellungen und schließen Sie das Fenster, um den Wechsel abzuschließen."
          }
        }
      }
    },
    "%@ now resides in the %@ runtime container." : {
      "comment" : "Text displayed in a notification when a guest app is moved to a different runtime container. The first argument is the display name of the app. The second argument is the runtime container (iOS or Catalyst).",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now resides in the %2$@ runtime container."
          }
        },
        "ja" : {
          "stringUnit" : {
