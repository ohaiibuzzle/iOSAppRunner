    "Fake UIScreen to match the Mac's display and lock the window size (unless the app supports resizing)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fake UIScreen to match the Mac's display and lock the window size (unless the app supports resizing)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac のディスプレイに合わせて UIScreen を偽装し、ウインドウサイズを固定します（アプリがリサイズに対応している場合を除く）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 디스플레이에 맞춰 UIScreen을 가장하고 창 크기를 고정합니다(앱이 크기 조절을 지원하는 경우 제외)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giả lập UIScreen theo màn hình của Mac và khóa kích thước cửa sổ (trừ khi ứng dụng hỗ trợ đổi kích thước)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伪造 UIScreen 以匹配 Mac 的显示器，并锁定窗口大小（应用支持调整大小时除外）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偽造 UIScreen 以符合 Mac 的顯示器，並鎖定視窗大小（除非 App 支援調整大小）。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simula UIScreen para que coincida con la pantalla del Mac y bloquea el tamaño de la ventana (salvo que la app admita cambiar de tamaño)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simule UIScreen pour correspondre à l'écran du Mac et verrouille la taille de la fenêtre (sauf si l'app permet de la redimensionner)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fälscht UIScreen, damit es der Anzeige des Mac entspricht, und sperrt die Fenstergröße (sofern die App das Ändern der Größe nicht unterstützt)."
          }
        }
      }
    },
